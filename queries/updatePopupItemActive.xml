<?xml version="1.0" encoding="utf-8"?>
<query id="updatePopupItemActive" action="update">
    <tables><table name="triplepopup_slots" /></tables>
    <columns>
        <column name="is_active" var="is_active" notnull="notnull" />
    </columns>
    <conditions>
        <condition operation="equal" column="slot_number" var="slot_number" filter="number" notnull="notnull" />
    </conditions>
</query>
