<?xml version="1.0" encoding="utf-8"?>
<query id="updatePopupItem" action="update">
    <tables><table name="triplepopup_slots" /></tables>
    <columns>
        <column name="badge_text"      var="badge_text"      force="force" />
        <column name="badge_bg_color"  var="badge_bg_color" />
        <column name="badge_text_color" var="badge_text_color" />
        <column name="body_image"      var="body_image"      force="force" />
        <column name="body_images"     var="body_images"     force="force" />
        <column name="title_text"      var="title_text"      force="force" />
        <column name="sub_text"        var="sub_text"        force="force" />
        <column name="html_content"    var="html_content"    force="force" />
        <column name="html_position"   var="html_position" />
        <column name="html_bg_color"   var="html_bg_color" />
        <column name="html_bg_trans"   var="html_bg_trans"   force="force" />
        <column name="body_preset"     var="body_preset"     force="force" />
        <column name="source_document_srl" var="source_document_srl" force="force" />
        <column name="target_groups"   var="target_groups"   force="force" />
        <column name="click_url"       var="click_url"       force="force" />
        <column name="click_target"    var="click_target" />
        <column name="footer_text"     var="footer_text"     force="force" />
        <column name="footer_bg_color" var="footer_bg_color" />
        <column name="footer_text_color" var="footer_text_color" />
        <column name="start_date"      var="start_date"      force="force" />
        <column name="end_date"        var="end_date"        force="force" />
        <column name="is_active"       var="is_active" />
    </columns>
    <conditions>
        <condition operation="equal" column="slot_number" var="slot_number" filter="number" notnull="notnull" />
    </conditions>
</query>
